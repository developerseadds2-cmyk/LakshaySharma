# Apache configuration for clean extensionless URLs and 404 handling
RewriteEngine On

# Ensure DirectoryIndex finds index.php automatically for root domain / directory requests
DirectoryIndex index.php

# 404 Error Document Fallback
ErrorDocument 404 coming-soon.php

# 1. Redirect external direct requests from file.php to extensionless (e.g., about.php -> about)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s.*?/([^/?\s]+)\.php [NC]
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %1 !^index$ [NC]
RewriteRule ^ %1 [R=301,L]

# 2. If the request is for an existing real file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Internally map extensionless slug to .php file if it exists (e.g., /about -> about.php)
RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L]

# 4. Fallback: Route any non-existent page/slug to custom 404 page (coming-soon.php)
RewriteRule ^([a-zA-Z0-9_-]+)/?$ coming-soon.php?page=$1 [L,QSA]
