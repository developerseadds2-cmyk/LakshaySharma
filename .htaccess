# Apache configuration for clean extensionless URLs and 404 handling
RewriteEngine On

# Ensure DirectoryIndex finds index.php automatically for root folder requests
DirectoryIndex index.php

# Redirect external direct requests from file.php to file (except POST and index.php)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^/]+/)*([^.]+)\.php [NC]
RewriteCond %{REQUEST_METHOD} !POST
RewriteRule ^(.*)\.php$ $1 [R=301,L]

# Serve actual files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Internally rewrite clean extensionless URL to .php file if it exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L]

# Fallback: Route non-existent URLs to custom 404 page (coming-soon.php)
RewriteRule ^([a-zA-Z0-9_-]+)/?$ coming-soon.php?page=$1 [L,QSA]
